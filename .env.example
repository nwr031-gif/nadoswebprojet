# ============================================================
# DATABASE — Supabase PostgreSQL
# ============================================================
# App runtime connection (Transaction Pooler — port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Direct connection (port 5432) — for migrations only (db:push)
DATABASE_URL_DIRECT="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ============================================================
# AUTH — NextAuth
# ============================================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:9090"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================================================
# CLOUDFLARE R2 — File storage
# ============================================================
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="nados-files"
R2_PUBLIC_URL=""

# ============================================================
# EMAIL — Resend
# ============================================================
RESEND_API_KEY=""
EMAIL_FROM="NADOS <noreply@nados.iq>"

# ============================================================
# ClamAV (optional file scanning)
# ============================================================
CLAMAV_HOST="localhost"
CLAMAV_PORT="3310"

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:9090"
NEXT_PUBLIC_APP_NAME="NADOS"